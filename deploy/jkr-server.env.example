# jkr-server runtime env. Copy to /etc/jkr/jkr-server.env and chmod 0600.
#
# Generate a strong password:  openssl rand -hex 32

# REQUIRED for any non-loopback bind. Min 8 chars, but use 32+ in production.
JKR_ADMIN_PASSWORD=replace-me-with-a-real-secret-at-least-8-chars

# nginx fronts the server, so binding to loopback is enough.
HOST=127.0.0.1
PORT=4000

# Optional. Defaults shown.
# AI_PROVIDER=openai
# DATABASE_URL=
# SERVICE_NEEDS_SETUP=0
